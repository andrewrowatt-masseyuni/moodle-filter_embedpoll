<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="filter/embedpoll/db" VERSION="20260625" COMMENT="filter_embedpoll database tables"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="filter_embedpoll_poll" COMMENT="One row per embedded poll, lazily created on first view.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Context where the poll is embedded"/>
        <FIELD NAME="chapterid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Book chapter id, or 0 outside a book"/>
        <FIELD NAME="itemshash" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="sha1 of the JSON-encoded trimmed items array"/>
        <FIELD NAME="ordinal" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Occurrence index among same-hash polls in this context/chapter"/>
        <FIELD NAME="items" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Canonical JSON array of item labels captured at initiation"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Enclosing course id, or 0 if none"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="contextid_fk" TYPE="foreign" FIELDS="contextid" REFTABLE="context" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="poll_unique" UNIQUE="true" FIELDS="contextid, chapterid, itemshash, ordinal" COMMENT="Identifies a single poll"/>
        <INDEX NAME="courseid_idx" UNIQUE="false" FIELDS="courseid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="filter_embedpoll_vote" COMMENT="One vote per user per poll.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pollid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="choice" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="0-based index of the chosen item"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pollid_fk" TYPE="foreign" FIELDS="pollid" REFTABLE="filter_embedpoll_poll" REFFIELDS="id"/>
        <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="poll_user_unique" UNIQUE="true" FIELDS="pollid, userid" COMMENT="One vote per user per poll"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
